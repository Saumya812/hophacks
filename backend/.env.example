# FindMyPal backend — copy to .env and fill in real values
# Never commit the real .env file.

# Supabase project URL (Project Settings → API → Project URL)
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Prefer the service_role key for server-side writes (keep secret)
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# CORS origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Mock user id matching the seed row in db/schema.sql
MOCK_USER_ID=00000000-0000-0000-0000-000000000001
MOCK_USER_EMAIL=mock@findmypal.local
