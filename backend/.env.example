# FindMyPal backend — copy to .env and fill in real values
# Never commit the real .env file.

# Supabase project URL (Project Settings → API → Project URL)
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Prefer the service_role key for server-side writes (keep secret)
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional model override (leave blank to auto-detect)
GEMINI_MODEL=

# Face matching — AWS Rekognition (optional; DeepFace or Gemini Vision used otherwise)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Smart Person Search (/lookup) — all optional ---
# SerpAPI (Google search) https://serpapi.com/
SERPAPI_KEY=
# NewsAPI https://newsapi.org/
NEWSAPI_KEY=
# YouTube Data API v3
YOUTUBE_API_KEY=
# RapidAPI Twitter scraper
RAPIDAPI_KEY=
TWITTER_RAPIDAPI_HOST=twitter-api45.p.rapidapi.com

# Optional advanced integrations
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
BACKBOARD_API_KEY=
SPACETIMEDB_URI=
SNOWFLAKE_ACCOUNT=

# CORS origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Mock user id matching the seed row in db/schema.sql
MOCK_USER_ID=00000000-0000-0000-0000-000000000001
MOCK_USER_EMAIL=mock@findmypal.local
