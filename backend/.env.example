# FindMyPal backend — copy to .env and fill in real values
# Never commit the real .env file.

# Supabase server-side connection
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# CORS origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Mock user id matching the seed row
MOCK_USER_ID=00000000-0000-0000-0000-000000000001
MOCK_USER_EMAIL=mock@findmypal.local

# Smart Person Search (optional)
SERPAPI_KEY=
NEWSAPI_KEY=
YOUTUBE_API_KEY=
RAPIDAPI_KEY=
TWITTER_RAPIDAPI_HOST=twitter-api45.p.rapidapi.com
APIFY_TOKEN=

# Tip → police / family EmailJS (optional)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_FAMILY_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
POLICE_NOTIFICATION_EMAIL=notifications@findmypal.app

# Optional advanced
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
BACKBOARD_API_KEY=
SNOWFLAKE_ACCOUNT=
TRUST_PROXY=false
